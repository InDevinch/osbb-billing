@model MeterReadingFormViewModel
<p>Лічильник <strong>@Model.CurrentMeter.SerialNumber</strong> · @Model.CurrentMeter.PremiseService.Service.Name</p>
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<input asp-for="MeterId" type="hidden" />
@if (Model.CurrentReading is null)
{
    <div class="mb-3">
        <label asp-for="Period" class="form-label"></label>
        <input asp-for="Period" class="form-control" required />
        <span asp-validation-for="Period" class="text-danger"></span>
        <p class="form-text">Оберіть перше число місяця, за який вносите показання.</p>
    </div>
}
else
{
    <input asp-for="Period" type="hidden" />
    <p>Місяць: @Model.CurrentReading.Period.ToString("MM.yyyy")</p>
}
<div class="mb-3">
    <label asp-for="ReadingDate" class="form-label"></label>
    <input asp-for="ReadingDate" class="form-control" required />
    <span asp-validation-for="ReadingDate" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ReadingValue" class="form-label"></label>
    <input asp-for="ReadingValue" type="number" min="0" max="999999999999999.999" step="0.001" class="form-control" required />
    <span asp-validation-for="ReadingValue" class="text-danger"></span>
</div>
<button class="btn btn-primary" type="submit">Зберегти показання</button>
<a class="btn btn-outline-secondary" asp-controller="Meters" asp-action="Details" asp-route-id="@Model.MeterId">Скасувати</a>
