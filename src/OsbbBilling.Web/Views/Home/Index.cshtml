@inject IWebHostEnvironment Environment
@using OsbbBilling.Web.Security
@{
    ViewData["Title"] = "Головна";
}
<section class="py-4">
    <p class="text-secondary">Система обліку ОСББ</p>
    <h1>Нарахування та оплата послуг</h1>
    <p class="lead">Облік приміщень, особових рахунків, послуг і розрахунків із мешканцями.</p>
    <div class="alert alert-info">Доступні довідники, особові рахунки, лічильники, щомісячні нарахування та реєстрація оплат.</div>
</section>
<a class="btn btn-primary" asp-controller="Workspace" asp-action="Index">Мій кабінет</a>
@if (Environment.IsDevelopment() && User.IsInRole(Roles.Accountant))
{
    <a class="btn btn-primary mt-4" asp-controller="Development" asp-action="Database">Перевірити підключення до БД</a>
}
