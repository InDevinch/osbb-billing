@model TariffFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
@if (Model.CurrentTariff is null)
{
    <div class="mb-3">
        <label asp-for="BuildingId" class="form-label"></label>
        <select asp-for="BuildingId" asp-items="Model.Buildings" class="form-select"><option value="">Оберіть будинок</option></select>
        <span asp-validation-for="BuildingId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ServiceId" class="form-label"></label>
        <select asp-for="ServiceId" asp-items="Model.Services" class="form-select"><option value="">Оберіть послугу</option></select>
        <span asp-validation-for="ServiceId" class="text-danger"></span>
    </div>
}
else
{
    <input asp-for="BuildingId" type="hidden" />
    <input asp-for="ServiceId" type="hidden" />
    <p>@Model.CurrentTariff.Building.Address · @Model.CurrentTariff.Service.Name</p>
    <p>Попередня ціна: @Model.CurrentTariff.UnitPrice.ToString("0.####") грн / @Model.CurrentTariff.Service.Unit</p>
}
<div class="mb-3">
    <label asp-for="UnitPrice" class="form-label"></label>
    <input asp-for="UnitPrice" type="number" min="0" max="99999999999999.9999" step="0.0001" class="form-control" required />
    <span asp-validation-for="UnitPrice" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ValidFrom" class="form-label"></label>
    <input asp-for="ValidFrom" class="form-control" required />
    <span asp-validation-for="ValidFrom" class="text-danger"></span>
</div>
@if (Model.CurrentTariff is null)
{
    <div class="mb-3">
        <label asp-for="ValidTo" class="form-label"></label>
        <input asp-for="ValidTo" class="form-control" />
        <span asp-validation-for="ValidTo" class="text-danger"></span>
    </div>
}
<p class="text-secondary">Дати — перші числа місяців. Місяць завершення не входить у період дії.</p>
<button class="btn btn-primary" type="submit">Зберегти тариф</button>
<a class="btn btn-outline-secondary" asp-action="Index">Скасувати</a>
