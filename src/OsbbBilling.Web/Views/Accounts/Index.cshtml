@model AccountListViewModel
@using OsbbBilling.Web.Security
@{
    ViewData["Title"] = "Особові рахунки";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Особові рахунки</h1>
    @if (User.IsInRole(Roles.Accountant))
    {
        <a class="btn btn-primary" asp-action="Create" asp-route-ownerId="@Model.OwnerId" asp-route-premiseId="@Model.PremiseId">Відкрити рахунок</a>
    }
</div>
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <label asp-for="OwnerId" class="visually-hidden">Платник</label>
        <select asp-for="OwnerId" asp-items="Model.Owners" class="form-select"><option value="">Усі платники</option></select>
    </div>
    <div class="col-md-4">
        <label asp-for="PremiseId" class="visually-hidden">Приміщення</label>
        <select asp-for="PremiseId" asp-items="Model.Premises" class="form-select"><option value="">Усі приміщення</option></select>
    </div>
    <div class="col-md-4">
        <label asp-for="Status" class="visually-hidden">Стан рахунку</label>
        <select asp-for="Status" class="form-select">
            <option value="all">Усі стани</option><option value="active">Діє</option>
            <option value="planned">Запланований</option><option value="closed">Завершений</option>
        </select>
    </div>
    <div class="col-md-8">
        <label for="search" class="visually-hidden">Пошук рахунку</label>
        <input id="search" name="search" value="@Model.Search" class="form-control" type="search" placeholder="Номер рахунку, ПІБ, адреса або приміщення" />
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button class="btn btn-outline-primary" type="submit">Знайти</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Скинути</a>
    </div>
</form>
<p class="text-secondary">Знайдено: @Model.TotalCount</p>
@if (Model.Accounts.Count == 0)
{
    <p>Рахунків не знайдено.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th scope="col">Рахунок</th><th scope="col">Платник</th><th scope="col">Адреса</th><th scope="col">Приміщення</th><th scope="col">Діє з</th><th scope="col">Діє до, не включно</th><th scope="col">Стан</th></tr></thead>
            <tbody>
            @foreach (var account in Model.Accounts)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@account.AccountId">@account.AccountNumber</a></td>
                    <td>@account.Owner.FullName</td><td>@account.Premise.Building.Address</td><td>@account.Premise.Number</td>
                    <td>@account.ValidFrom.ToString("dd.MM.yyyy")</td><td>@(account.ValidTo?.ToString("dd.MM.yyyy") ?? "—")</td>
                    <td>@AccountStatuses.DisplayName(account)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@if (Model.TotalPages > 1)
{
    <nav aria-label="Сторінки рахунків" class="d-flex gap-3">
        @if (Model.Page > 1)
        {
            <a asp-action="Index" asp-route-ownerId="@Model.OwnerId" asp-route-premiseId="@Model.PremiseId" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)">Назад</a>
        }
        <span>Сторінка @Model.Page з @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-action="Index" asp-route-ownerId="@Model.OwnerId" asp-route-premiseId="@Model.PremiseId" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)">Далі</a>
        }
    </nav>
}
