@model PaymentFormViewModel
@{
    ViewData["Title"] = "Реєстрація оплати";
}
<h1>Зареєструвати оплату</h1>
<p>Внесіть оплату за платіжним документом. Вона погасить найстаріший борг обраного рахунку; залишок стане авансом.</p>
<form asp-action="Create" method="post" style="max-width: 650px">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="AccountId" class="form-label"></label>
        <select asp-for="AccountId" asp-items="Model.Accounts" class="form-select"><option value="">Оберіть рахунок</option></select>
        <span asp-validation-for="AccountId" class="text-danger"></span>
        <div class="form-text">Завершений рахунок також доступний для погашення старого боргу.</div>
    </div>
    <div class="mb-3">
        <label asp-for="PaymentDate" class="form-label"></label>
        <input asp-for="PaymentDate" class="form-control" required />
        <span asp-validation-for="PaymentDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" required />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Reference" class="form-label"></label>
        <input asp-for="Reference" class="form-control" maxlength="100" required />
        <span asp-validation-for="Reference" class="text-danger"></span>
        <div class="form-text">Унікальний номер квитанції або банківської операції. Для повторної спроби використовуйте той самий номер.</div>
    </div>
    <button class="btn btn-primary" type="submit">Зареєструвати оплату</button>
    <a class="btn btn-outline-secondary" asp-action="Index" asp-route-accountId="@(Model.AccountId > 0 ? Model.AccountId : null)">До списку</a>
</form>
