@model PremiseListViewModel
@using OsbbBilling.Web.Security
@{
    ViewData["Title"] = "Приміщення";
    var canEdit = User.IsInRole(Roles.Accountant);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Приміщення</h1>
    @if (canEdit)
    {
        <a class="btn btn-primary" asp-action="Create" asp-route-buildingId="@Model.BuildingId">Додати приміщення</a>
    }
</div>
<form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 mb-3">
    <label asp-for="BuildingId" class="visually-hidden">Будинок</label>
    <select asp-for="BuildingId" asp-items="Model.Buildings" class="form-select" style="max-width: 380px">
        <option value="">Усі будинки</option>
    </select>
    <label for="search" class="visually-hidden">Номер або адреса</label>
    <input id="search" name="search" value="@Model.Search" type="search" class="form-control"
           placeholder="Номер або адреса" style="max-width: 260px" />
    <button class="btn btn-outline-primary" type="submit">Знайти</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Скинути</a>
</form>
<p class="text-secondary">Знайдено: @Model.TotalCount</p>
@if (Model.Premises.Count == 0)
{
    <p>Приміщень не знайдено.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th scope="col">Будинок</th><th scope="col">Номер</th><th scope="col">Тип</th><th scope="col">Площа, м²</th><th scope="col">Мешканців</th><th scope="col">Дії</th></tr></thead>
            <tbody>
            @foreach (var premise in Model.Premises)
            {
                <tr>
                    <td>@premise.Building.Address</td>
                    <td><a asp-action="Details" asp-route-id="@premise.PremiseId">@premise.Number</a></td>
                    <td>@PremiseKinds.DisplayName(premise.Kind)</td>
                    <td>@premise.Area.ToString("0.00")</td><td>@premise.ResidentsCount</td>
                    <td>
                        @if (canEdit)
                        {
                            <a asp-action="Edit" asp-route-id="@premise.PremiseId">Редагувати</a>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@premise.PremiseId">Переглянути</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@if (Model.TotalPages > 1)
{
    <nav aria-label="Сторінки приміщень" class="d-flex gap-3">
        @if (Model.Page > 1)
        {
            <a asp-action="Index" asp-route-buildingId="@Model.BuildingId" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">Назад</a>
        }
        <span>Сторінка @Model.Page з @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-action="Index" asp-route-buildingId="@Model.BuildingId" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">Далі</a>
        }
    </nav>
}
