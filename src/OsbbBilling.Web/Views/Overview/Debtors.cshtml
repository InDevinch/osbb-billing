@model DebtorListViewModel
@{
    ViewData["Title"] = "Боржники";
}
<h1>Боржники</h1>
<p class="text-secondary">Рахунки з поточним непогашеним боргом, включаючи завершені. Один платник може мати кілька рахунків у списку.</p>
<form asp-action="Debtors" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <label asp-for="BuildingId" class="form-label">Будинок</label>
        <select asp-for="BuildingId" asp-items="Model.Buildings" class="form-select"><option value="">Усі будинки</option></select>
        <span asp-validation-for="BuildingId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MinimumDebt" class="form-label">Борг від, грн</label>
        <input asp-for="MinimumDebt" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="MinimumDebt" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label for="search" class="form-label">Пошук</label>
        <input id="search" name="search" value="@Model.Search" class="form-control" type="search" placeholder="Рахунок, ПІБ, адреса або приміщення" />
    </div>
    <div class="col-12 d-flex gap-2">
        <button class="btn btn-outline-primary" type="submit">Знайти</button>
        <a class="btn btn-outline-secondary" asp-action="Debtors">Скинути</a>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-buildingId="@Model.BuildingId">До огляду</a>
    </div>
</form>
<p class="text-secondary">Рахунків із боргом за вибіркою: @Model.TotalCount · Загальний борг за вибіркою: @Model.TotalDebt.ToString("0.00") грн</p>
@if (Model.Debtors.Count == 0)
{
    <p>Боржників за обраними умовами не знайдено.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th scope="col">Рахунок</th><th scope="col">Платник</th><th scope="col">Адреса</th><th scope="col">Приміщення</th><th scope="col">Борг, грн</th></tr></thead>
            <tbody>
            @foreach (var debtor in Model.Debtors)
            {
                <tr>
                    <td><a asp-controller="Accounts" asp-action="Details" asp-route-id="@debtor.AccountId">@debtor.AccountNumber</a></td>
                    <td>@debtor.OwnerName</td><td>@debtor.Address</td><td>@debtor.PremiseNumber</td><td>@debtor.DebtAmount.ToString("0.00")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@if (Model.TotalPages > 1)
{
    <nav class="d-flex gap-3" aria-label="Сторінки боржників">
        @if (Model.Page > 1)
        {
            <a asp-action="Debtors" asp-route-buildingId="@Model.BuildingId" asp-route-search="@Model.Search" asp-route-minimumDebt="@Model.MinimumDebt?.ToString(System.Globalization.CultureInfo.InvariantCulture)" asp-route-page="@(Model.Page - 1)">Назад</a>
        }
        <span>Сторінка @Model.Page з @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-action="Debtors" asp-route-buildingId="@Model.BuildingId" asp-route-search="@Model.Search" asp-route-minimumDebt="@Model.MinimumDebt?.ToString(System.Globalization.CultureInfo.InvariantCulture)" asp-route-page="@(Model.Page + 1)">Далі</a>
        }
    </nav>
}
