@using OsbbBilling.Web.Security
@using System.Security.Claims
@{
    var roleName = Roles.DisplayName(User.FindFirstValue(ClaimTypes.Role));
    ViewData["Title"] = roleName;
}
<h1>Кабінет: @roleName</h1>
<p>Ви увійшли як <strong>@User.Identity?.Name</strong>.</p>
<a class="btn btn-primary" asp-controller="Owners" asp-action="Index">Власники</a>
