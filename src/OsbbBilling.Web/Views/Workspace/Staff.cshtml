@using OsbbBilling.Web.Security
@using System.Security.Claims
@{
    var roleName = Roles.DisplayName(User.FindFirstValue(ClaimTypes.Role));
    ViewData["Title"] = roleName;
}
<h1>Кабінет: @roleName</h1>
<p>Ви увійшли як <strong>@User.Identity?.Name</strong>.</p>
<a class="btn btn-primary" asp-controller="Owners" asp-action="Index">Власники</a>
<a class="btn btn-primary" asp-controller="Buildings" asp-action="Index">Будинки</a>
<a class="btn btn-primary" asp-controller="Premises" asp-action="Index">Приміщення</a>
<a class="btn btn-primary" asp-controller="Accounts" asp-action="Index">Особові рахунки</a>
<a class="btn btn-primary" asp-controller="Services" asp-action="Index">Послуги</a>
<a class="btn btn-primary" asp-controller="Tariffs" asp-action="Index">Тарифи</a>
<a class="btn btn-primary" asp-controller="Meters" asp-action="Index">Лічильники</a>
<a class="btn btn-primary" asp-controller="PremiseServices" asp-action="Index">Послуги приміщень</a>
