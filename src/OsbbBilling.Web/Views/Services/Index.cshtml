@model ServiceListViewModel
@using OsbbBilling.Web.Security
@{
    ViewData["Title"] = "Послуги";
}
@if (TempData["Success"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Послуги</h1>
    @if (User.IsInRole(Roles.Accountant))
    {
        <a class="btn btn-primary" asp-action="Create">Додати послугу</a>
    }
</div>
<form asp-action="Index" method="get" class="d-flex gap-2 mb-3">
    <label for="search" class="visually-hidden">Пошук послуги</label>
    <input id="search" name="search" value="@Model.Search" type="search" class="form-control" placeholder="Назва або одиниця виміру" />
    <button class="btn btn-outline-primary" type="submit">Знайти</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Скинути</a>
</form>
<p class="text-secondary">Знайдено: @Model.TotalCount</p>
@if (Model.Services.Count == 0)
{
    <p>Послуг не знайдено.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th scope="col">Назва</th><th scope="col">Одиниця</th><th scope="col">Розрахунок</th><th scope="col">Дії</th></tr></thead>
            <tbody>
            @foreach (var service in Model.Services)
            {
                <tr>
                    <td>@service.Name</td><td>@service.Unit</td><td>@CalculationMethods.DisplayName(service.CalculationMethod)</td>
                    <td class="text-nowrap">
                        <a asp-controller="Tariffs" asp-action="Index" asp-route-serviceId="@service.ServiceId">Тарифи</a>
                        <a class="ms-2" asp-controller="PremiseServices" asp-action="Index" asp-route-serviceId="@service.ServiceId">Підключення</a>
                        @if (User.IsInRole(Roles.Accountant))
                        {
                            <a class="ms-2" asp-action="Edit" asp-route-id="@service.ServiceId">Редагувати</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@if (Model.TotalPages > 1)
{
    <nav class="d-flex gap-3" aria-label="Сторінки">
        @if (Model.Page > 1)
        {
            <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">Назад</a>
        }
        <span>Сторінка @Model.Page з @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">Далі</a>
        }
    </nav>
}
