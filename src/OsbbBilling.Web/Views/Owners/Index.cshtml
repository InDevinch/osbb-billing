@model OwnerListViewModel
@using OsbbBilling.Web.Security
@{
    ViewData["Title"] = "Власники";
    var canEdit = User.IsInRole(Roles.Accountant);
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Власники</h1>
    @if (canEdit)
    {
        <a class="btn btn-primary" asp-action="Create">Додати власника</a>
    }
</div>
<form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 mb-3">
    <label for="search" class="visually-hidden">Пошук власника</label>
    <input id="search" name="search" value="@Model.Search" class="form-control" type="search"
           placeholder="ПІБ, телефон або електронна пошта" style="max-width: 440px" />
    <button class="btn btn-outline-primary" type="submit">Знайти</button>
    @if (!string.IsNullOrEmpty(Model.Search))
    {
        <a class="btn btn-outline-secondary" asp-action="Index">Скинути</a>
    }
</form>
<p class="text-secondary">Знайдено: @Model.TotalCount</p>
@if (Model.Owners.Count == 0)
{
    <p>Власників не знайдено.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th scope="col">ПІБ</th><th scope="col">Телефон</th><th scope="col">Електронна пошта</th><th scope="col">Рахунків</th><th scope="col">Дії</th></tr></thead>
            <tbody>
            @foreach (var owner in Model.Owners)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@owner.OwnerId">@owner.FullName</a></td>
                    <td>@(owner.Phone ?? "—")</td>
                    <td>@(owner.Email ?? "—")</td>
                    <td>@owner.AccountCount</td>
                    <td>
                        @if (canEdit)
                        {
                            <a asp-action="Edit" asp-route-id="@owner.OwnerId">Редагувати</a>
                        }
                        else
                        {
                            <a asp-action="Details" asp-route-id="@owner.OwnerId">Переглянути</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@if (Model.TotalPages > 1)
{
    <nav aria-label="Сторінки власників" class="d-flex align-items-center gap-3">
        @if (Model.Page > 1)
        {
            <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">Назад</a>
        }
        <span>Сторінка @Model.Page з @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">Далі</a>
        }
    </nav>
}
