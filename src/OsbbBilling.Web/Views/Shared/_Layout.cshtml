@inject IWebHostEnvironment Environment
@using OsbbBilling.Web.Security
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ОСББ</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="border-bottom mb-4">
        <nav class="container d-flex flex-wrap align-items-center gap-3 py-3" aria-label="Головна навігація">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">ОСББ · Облік послуг</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Workspace" asp-action="Index">Мій кабінет</a>
                @if (User.IsInRole(Roles.Accountant) || User.IsInRole(Roles.Chairperson))
                {
                    <a asp-controller="Owners" asp-action="Index">Власники</a>
                    <a asp-controller="Buildings" asp-action="Index">Будинки</a>
                    <a asp-controller="Premises" asp-action="Index">Приміщення</a>
                    <a asp-controller="Accounts" asp-action="Index">Рахунки</a>
                }
                @if (Environment.IsDevelopment() && User.IsInRole(Roles.Accountant))
                {
                    <a asp-controller="Development" asp-action="Database">Перевірка БД</a>
                }
                <span class="ms-auto">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn btn-outline-secondary btn-sm" type="submit">Вийти</button>
                </form>
            }
        </nav>
    </header>
    <main class="container pb-5">@RenderBody()</main>
    <footer class="container border-top py-3 text-secondary">Навчальний проєкт · ОСББ</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
