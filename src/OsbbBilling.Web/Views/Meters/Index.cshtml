@model MeterListViewModel
@using OsbbBilling.Web.Security
@{
    ViewData["Title"] = "Лічильники";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Лічильники</h1>
    @if (User.IsInRole(Roles.Accountant))
    {
        <a class="btn btn-primary" asp-action="Create" asp-route-premiseServiceId="@Model.PremiseServiceId">Встановити лічильник</a>
    }
</div>
<form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 mb-3">
    <label asp-for="PremiseServiceId" class="visually-hidden">Послуга приміщення</label>
    <select asp-for="PremiseServiceId" asp-items="Model.Assignments" class="form-select" style="max-width: 500px"><option value="">Усі підключення</option></select>
    <label for="search" class="visually-hidden">Серійний номер або адреса</label>
    <input id="search" name="search" value="@Model.Search" type="search" class="form-control" style="max-width: 280px" placeholder="Серійний номер або адреса" />
    <button class="btn btn-outline-primary" type="submit">Знайти</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Скинути</a>
</form>
<p class="text-secondary">Знайдено: @Model.TotalCount</p>
@if (Model.Meters.Count == 0)
{
    <p>Лічильників не знайдено.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th scope="col">Номер</th><th scope="col">Адреса</th><th scope="col">Приміщення</th><th scope="col">Послуга</th><th scope="col">Працює з</th><th scope="col">Працює до, не включно</th></tr></thead>
            <tbody>
            @foreach (var meter in Model.Meters)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@meter.MeterId">@meter.SerialNumber</a></td>
                    <td>@meter.PremiseService.Premise.Building.Address</td><td>@meter.PremiseService.Premise.Number</td>
                    <td>@meter.PremiseService.Service.Name</td><td>@meter.InstalledOn.ToString("dd.MM.yyyy")</td>
                    <td>@(meter.RemovedOn?.ToString("dd.MM.yyyy") ?? "Не визначено")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@if (Model.TotalPages > 1)
{
    <nav class="d-flex gap-3" aria-label="Сторінки лічильників">
        @if (Model.Page > 1)
        {
            <a asp-action="Index" asp-route-premiseServiceId="@Model.PremiseServiceId" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">Назад</a>
        }
        <span>Сторінка @Model.Page з @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-action="Index" asp-route-premiseServiceId="@Model.PremiseServiceId" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">Далі</a>
        }
    </nav>
}
